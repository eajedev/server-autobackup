# eaje-autobackup configuration — copy to /etc/eaje-autobackup/config.env
# and chmod 600. Never commit a filled-in copy anywhere.

# Where the backups live. Contabo's Auto Backup stores off-server; so must
# this. Pick ONE repository line:
#
#   Contabo Object Storage (S3-compatible, separate Contabo infrastructure):
#     RESTIC_REPOSITORY=s3:https://eu2.contabostorage.com/<tenant-id>:<bucket-name>
#     + AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.
#     The region host differs per region (EU: eu2.contabostorage.com,
#     US: usc1.contabostorage.com). Your tenant id is shown in the panel
#     next to your bucket (it prefixes the bucket name, tenant:bucket).
#     Keys: panel -> Account -> Security & Access -> S3 Object Storage
#     Credentials.
#   Backblaze B2 (S3-compatible):
#     RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/<bucket>
#   Another server over SSH:
#     RESTIC_REPOSITORY=sftp:user@backup-host:/path/to/repo
#   A mounted remote/local disk (protects against deletion/corruption on the
#   server, NOT against losing the server itself — last-resort option only):
#     RESTIC_REPOSITORY=/mnt/backup-drive/autobackup-repo
RESTIC_REPOSITORY=

# File holding the restic repository password (root-only, chmod 600).
# Generated by install.sh. WITHOUT THIS PASSWORD THE BACKUPS CANNOT BE
# RESTORED — keep a copy of it somewhere off this server.
RESTIC_PASSWORD_FILE=/etc/eaje-autobackup/repo-password

# S3 credentials (only for s3: repositories). Leave empty otherwise.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# Optional: override what gets backed up (space-separated paths).
# Default: /data /var/lib/docker/volumes /etc /root + the DB dump dir.
# BACKUP_SOURCES="/data /var/lib/docker/volumes /etc /root"
