# Contabo API credentials for the OPTIONAL snapshot layer
# (contabo-snapshot-rotate.sh). Copy to /etc/eaje-autobackup/contabo-api.env
# and chmod 600. Create the API client in the Contabo panel (API section).
# Never commit a filled-in copy anywhere.
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
